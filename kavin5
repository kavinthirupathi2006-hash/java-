import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int age = sc.nextInt();
        sc.nextLine();
        String city = sc.nextLine();

        System.out.println("Age: " + age);
        System.out.println("City: " + city);

        sc.close();
    }
}
